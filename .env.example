# Isaac Codex — variables d'environnement (copiez ce fichier en .env pour le développement local).
# Sur Pterodactyl, ces valeurs sont gérées par les variables de l'egg.

# production | development
NODE_ENV=production

# Port HTTP. Laisser vide sur Pterodactyl : SERVER_PORT (port attribué) est alors utilisé automatiquement.
PORT=
# Interface d'écoute (0.0.0.0 pour accepter les connexions externes / du reverse proxy)
HOST=0.0.0.0

# Base SQLite (chemin relatif à la racine du projet). Doit se trouver dans un dossier persistant.
DATABASE_PATH=data/isaac-codex.sqlite

# trace | debug | info | warn | error
LOG_LEVEL=info
# pretty (lisible) | json
LOG_FORMAT=pretty

# URL publique (ex. https://codex.example.fr), affichée dans les logs ; facultative.
APP_BASE_URL=

# Faire confiance aux en-têtes X-Forwarded-* (true derrière un reverse proxy HTTPS)
TRUST_PROXY=true
# Autoriser la création de profils (false pour une instance publique « en lecture seule »)
ALLOW_PROFILE_CREATION=true
# Sauvegarde automatique de la base au démarrage (au plus une toutes les 12 h) et nombre de sauvegardes conservées
BACKUP_ON_START=true
BACKUP_KEEP=7
# Requêtes par minute et par IP
RATE_LIMIT_MAX=300
# Créations de profil, connexions et imports par IP et par tranche de 15 minutes
AUTH_RATE_LIMIT_MAX=10
# Dossier des sprites fournis légalement par l'utilisateur (voir data/sprites/README.md)
SPRITES_DIR=data/sprites

# Base des profils (libSQL / Turso). Vide → fichier SQLite local (DATABASE_PATH).
# Sur Vercel : obligatoire pour conserver les profils (posées automatiquement par l'intégration Turso).
TURSO_DATABASE_URL=libsql://isaaccodex-lestitcheur.aws-eu-central-1.turso.io
