{
  "name": "isaac-codex",
  "version": "1.0.0",
  "private": true,
  "description": "Isaac Codex — wiki interactif non officiel de The Binding of Isaac (Rebirth → Repentance+)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:server": "tsup --config apps/server/tsup.config.ts",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate --config apps/server/drizzle.config.ts",
    "db:migrate": "node dist/server/index.js --migrate-only",
    "db:backup": "node dist/server/index.js --backup",
    "data:fetch": "tsx scripts/data/fetch-wiki.ts",
    "data:build": "tsx scripts/data/build-dataset.ts",
    "data:import": "tsx scripts/data/import-file.ts",
    "assets:extract": "tsx scripts/assets/extract-mod-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@libsql/client": "^0.15.15",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.8",
    "fuse.js": "^7.5.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "lucide-react": "^1.70.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
